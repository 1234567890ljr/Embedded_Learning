{
  "version": 4,
  "configurations": [
    {
      "name": "Windows MSYS2 UCRT64",
      "compilerPath": "C:/msys64/ucrt64/bin/gcc.exe",
      "cStandard": "c17",
      "intelliSenseMode": "windows-gcc-x64",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
