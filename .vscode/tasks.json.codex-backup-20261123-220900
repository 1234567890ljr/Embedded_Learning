{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "gcc: 编译当前文件",
      "type": "shell",
      "command": "gcc",
      "args": ["-g", "-fexec-charset=GBK", "${file}", "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "gcc: 编译并运行",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", "gcc -g -fexec-charset=GBK \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" && \"${fileDirname}\\${fileBasenameNoExtension}.exe\""],
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
